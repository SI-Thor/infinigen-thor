new file mode 100644
index 0000000..2652fc9
--- /dev/null
+++ b/src/infinigen2/util/tracing.py
@@ -0,0 +1,17 @@
+# Copyright (C) 2026, Princeton University.
+# This source code is licensed under the BSD-3-Clause license found in the LICENSE file in the root directory of this source tree.
+
+import procfunc as pf
+
+
+def is_tracing() -> bool:
+    """True while procfunc's tracer is capturing a compute graph.
+
+    Scene code that queries realized geometry (collision tests, bbox reads,
+    snapping) cannot be traced: the geometry does not exist yet, so its
+    attributes are graph proxies with no runtime value. Such code branches on
+    this flag and takes a trace-time assumption instead, so that the traced
+    graph records the surrounding grammar. See scenes/placement/*.py for the
+    assumptions themselves.
+    """
+    return pf.context.globals.current_trace_level is not None
