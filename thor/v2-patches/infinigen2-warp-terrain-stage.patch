+"""The v1 `mountains` terrain element as a v2/procfunc stage.
+
+The numeric kernel is the Warp port validated bit-identical against
+Infinigen's own CPU and CUDA libraries in docs/lab/exp-warp-terrain-port.md
+(max |diff| = 0.0 over 16M points, 6x Infinigen's hand-written CUDA kernel).
+It is kept verbatim here; the wrapper around it is new.
+
+Two layers, per v2's convention:
+
+- `mountains_params_rand` is the *grammar*: it samples the element's
+  parameters with pf.random (v1's landtiles ranges), so every draw is a
+  recorded, seed-controlled node of the recipe graph.
+- `mountains_heightfield` is the *realized compute*: an opaque tracer
+  primitive that evaluates the element on the GPU and builds the displaced
+  plane. The tracer records the call and its parameter nodes; the GPU work
+  happens at render time, exactly like modifier baking.
+
+`terrain_scene_rand` composes the stage with sky lighting and a grammar-driven
+camera into a renderable outdoor scene.
+"""
+
+import logging
+import math
+from typing import NamedTuple
+
+import bpy
+import numpy as np
+import procfunc as pf
+import warp as wp
+
+from infinigen2.lighting.sky_lighting import sky_hosek_wilkie_with_sun_lamp_rand
+from infinigen2.shaders.base_materials.granite import granite_rand
+
+__all__ = [
+    "MountainsParams",
+    "mountains_params_rand",
+    "mountains_heightfield",
+    "mountains_terrain_rand",
+    "terrain_scene_rand",
+]
+
+logger = logging.getLogger(__name__)
+
