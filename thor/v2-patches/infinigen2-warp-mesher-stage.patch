+"""The OcMesher as a v2 stage: lab 4's Warp SDF evaluation wired into the mesher.
+
+docs/lab/exp-warp-mesher-sdf.md measured that the real OcMesher spends
+67.6–69.8 % of its wall inside SDF evaluation, and that the two elements of a
+realistic terrain scene (``mountains`` + ``warped_rocks``, the CPU libraries
+Infinigen ships) are **bit-identical in Warp** (max |diff| = 0.0 on the
+mesher's own octree batches, and against a compiled-from-header oracle at
+every intermediate) at 75–85× the CPU libraries. This module turns that
+result into an engine stage:
+
+- the numeric kernels are the verified ports, kept verbatim (``mountains``
+  from round 2's ``warp_mountains``; ``warped_rocks`` from lab 4);
+- :class:`WarpSDFElement` adapts an element to the OcMesher's kernel ABI
+  (call a batch of points, get SDF values back) with resident device buffers;
+  :class:`CpuSDFElement` is the same adapter over Infinigen's own CPU
+  libraries — the verification and the timing baseline;
+- ``terrain_mesh_params_rand`` is the *grammar* (element seeds and ranges,
+  camera placement, LOD) so every draw is a recorded, seed-controlled node;
+- ``terrain_mesh`` is the *realized compute*: an opaque tracer primitive that
+  runs the real OcMesher (the vendored prebuilt ``core.so``) with the SDF
+  answered on the GPU, and links the resulting meshes into the scene. A
+  camera or parameter edit is a graph edit, and re-meshing — the expensive
+  part — is this leaf's execution: live re-meshing is a stage, not a rebuild.
+
+``terrain_mesh_scene_rand`` composes it with sky lighting and material into a
+renderable outdoor scene, the same shape as round 2's ``terrain_scene_rand``.
+"""
+
+import ctypes
+import logging
+import math
+import os
+from pathlib import Path
+from typing import Any, Callable, NamedTuple
+
+import bpy
+import numpy as np
+import procfunc as pf
+import warp as wp
+
+from infinigen2.terrain.warp_mountains import (
+    _grads_array,
+    _warp_init,
+    hash_to_float1,
+    log_uniform,
+    mountains_kernel,
+    myhash2,
+    myhash3,
+    perlin,
+    rampf,
+)
+
+__all__ = [
+    "CpuSDFElement",
+    "TerrainMeshParams",
+    "WarpSDFElement",
+    "terrain_mesh",
+    "terrain_mesh_params_rand",
+    "terrain_mesh_scene_rand",
+]
+
+logger = logging.getLogger(__name__)
+
+#: The vendored pieces lab 4 left: the OcMesher package and the element
+#: libraries/headers copied out of the v1 tree (nothing there is written).
+#: this file is <worktree>/src/infinigen-upstream/src/infinigen2/terrain/
+#: warp_mesher.py, so the worktree root is five parents up; an engine that
+#: installs the vendored pieces elsewhere points INFINIGEN_TERRAIN_VENDOR
+#: at it instead.
+_VENDOR = Path(
+    os.environ.get("INFINIGEN_TERRAIN_VENDOR")
+    or (Path(__file__).resolve().parents[5] / "vendor")
+)
+_OCMESHER_PATH = _VENDOR / "OcMesher"
+_TERRAIN_PATH = _VENDOR / "infinigen-terrain"
+
+_SENSOR_WIDTH_MM = 36.0  # Blender's default camera sensor
+
