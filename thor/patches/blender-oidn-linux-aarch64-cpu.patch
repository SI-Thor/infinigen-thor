diff --git a/build_files/build_environment/cmake/openimagedenoise.cmake b/build_files/build_environment/cmake/openimagedenoise.cmake
index 7fde62c..b42a3e7 100644
--- a/build_files/build_environment/cmake/openimagedenoise.cmake
+++ b/build_files/build_environment/cmake/openimagedenoise.cmake
@@ -9,6 +9,14 @@ set(OIDN_EXTRA_ARGS
   -DOIDN_FILTER_RTLIGHTMAP=OFF
   -DPython_EXECUTABLE=${PYTHON_BINARY}
 )
+
+# Linux aarch64 has no dpcpp, ocloc or level-zero, and the SYCL/CUDA/HIP OIDN
+# devices do not apply to it either: build the CPU (NEON) device only, with
+# the default toolchain instead of Intel's SYCL compilers.
+if(UNIX AND NOT APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
+  set(BLENDER_PLATFORM_LINUX_AARCH64 TRUE)
+endif()
+
 if(APPLE)
   set(OIDN_EXTRA_ARGS
     ${OIDN_EXTRA_ARGS}
@@ -21,8 +29,9 @@ else()
     -DLEVEL_ZERO_ROOT=${LIBDIR}/level-zero
   )
 
-  # x64 platforms support SyCL, ARM64 don't
-  if(NOT BLENDER_PLATFORM_WINDOWS_ARM)
+  # x64 platforms support SyCL, ARM64 don't (Windows ARM64 and Linux aarch64
+  # build the CPU device only)
+  if(NOT BLENDER_PLATFORM_WINDOWS_ARM AND NOT BLENDER_PLATFORM_LINUX_AARCH64)
     set(OIDN_EXTRA_ARGS
       ${OIDN_EXTRA_ARGS}
       -DOIDN_DEVICE_SYCL=ON
@@ -48,7 +57,7 @@ if(WIN32 AND NOT BLENDER_PLATFORM_WINDOWS_ARM)
     -DCMAKE_EXE_LINKER_FLAGS=-L"${LIBDIR}/dpcpp/lib"
   )
 else()
-  if(NOT (APPLE OR BLENDER_PLATFORM_WINDOWS_ARM))
+  if(NOT (APPLE OR BLENDER_PLATFORM_WINDOWS_ARM OR BLENDER_PLATFORM_LINUX_AARCH64))
     set(OIDN_EXTRA_ARGS
       ${OIDN_EXTRA_ARGS}
       -DCMAKE_CXX_COMPILER=${LIBDIR}/dpcpp/bin/clang++
@@ -99,7 +108,7 @@ add_dependencies(
   external_python
 )
 
-if(UNIX AND NOT APPLE)
+if(UNIX AND NOT APPLE AND NOT BLENDER_PLATFORM_LINUX_AARCH64)
   add_dependencies(
     external_openimagedenoise
     external_dpcpp
@@ -107,7 +116,7 @@ if(UNIX AND NOT APPLE)
   )
 endif()
 
-if(NOT APPLE)
+if(NOT APPLE AND NOT BLENDER_PLATFORM_LINUX_AARCH64)
   add_dependencies(
     external_openimagedenoise
     external_level-zero
